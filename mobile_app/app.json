{
  "expo": {
    "name": "Station Irrigation",
    "slug": "station-irrigation-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.hackathon.stationirrigation",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Station Irrigation to use your location for local weather."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "station-alerts",
          "color": "#1A73E8"
        }
      ]
    ]
  }
}
